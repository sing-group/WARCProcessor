<?xml version="1.0" encoding="UTF-8"?>
<Configuration>
   <Appenders>
      <Console name="consoleAppender" target="SYSTEM_OUT">
         <PatternLayout pattern="%d %-5p [%c{1}] %m%n" />
      </Console>
   </Appenders>
   <Loggers>
      <Root level="INFO">
         <AppenderRef ref="consoleAppender" />
      </Root>
   </Loggers>
</Configuration>
